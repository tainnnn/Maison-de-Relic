{
  "name": "maison-de-relic-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "down": "docker compose down",
    "rebuild": "docker compose up --build --renew-anon-volumes",
    "logs": "docker compose logs -f api",
    "db:migrate": "docker compose exec api npm run db:migrate",
    "db:seed": "docker compose exec api npm run db:seed",
    "db:reset": "docker compose exec api npm run db:reset",
    "test": "docker compose exec api npm test",
    "build": "node scripts/build-portfolio-vercel.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.4",
    "pg": "^8.13.0"
  }
}
